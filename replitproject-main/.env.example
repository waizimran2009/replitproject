# =============================================
# Company AI Management System — Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# AI — Keep Gemini as example (replace with open-source model later)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — used for DALL-E image generation in Post Automation
OPENAI_API_KEY=your_openai_api_key_here

# Supabase — Full database system
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Email Automation (Gmail recommended)
EMAIL_USER=your_company@gmail.com
EMAIL_PASS=your_gmail_app_password    # Use App Password, not regular password

# Call Automation (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Set webhook in Twilio console: https://your-domain/api/calls/webhook

# Company Info (used by AI phone receptionist)
COMPANY_NAME=TechCorp Solutions
COMPANY_SERVICES=software development, AI consulting, web design, mobile apps

# Server
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/db   # Legacy — replaced by Supabase
NODE_ENV=development
